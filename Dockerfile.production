# syntax=docker/dockerfile:1-labs@sha256:7eca9451d94f9b8ad22e44988b92d595d3e4d65163794237949a8c3413fbed5d

ARG NODE_VERSION=22.18.0

FROM node:${NODE_VERSION}-bookworm-slim

ARG GHOST_BUILD_VERSION=""

ENV NODE_ENV=production \
    GHOST_BUILD_VERSION=${GHOST_BUILD_VERSION} \
    LD_PRELOAD=libjemalloc.so.2

WORKDIR /home/ghost

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libjemalloc2 \
        fontconfig \
        build-essential \
        python3 \
        git \
        ca-certificates \
        curl && \
    rm -rf /var/lib/apt/lists/* && \
    groupmod -g 1001 node && \
    usermod -u 1001 node && \
    adduser --disabled-password --gecos "" -u 1000 ghost

COPY . .

RUN corepack enable && \
    corepack prepare pnpm@10.33.0 --activate

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=pnpm-store \
    pnpm install --ignore-scripts --prefer-offline && \
    if [ -d node_modules/sqlite3 ]; then cd node_modules/sqlite3 && npm run install; fi

RUN if [ -f nx.json ]; then \
        pnpm exec nx run ghost:build:tsc && \
        pnpm exec nx run ghost:build:assets && \
        pnpm exec nx run @tryghost/admin:build; \
    else \
        cd ghost/core && \
        pnpm run build:tsc && \
        pnpm run build:assets; \
    fi

WORKDIR /home/ghost/ghost/core

RUN mkdir -p default log content && \
    if [ -d content ]; then \
        cp -R content base_content; \
        if [ -d content/themes/casper ]; then cp -R content/themes/casper default/casper; fi; \
        if [ -d content/themes/source ]; then cp -R content/themes/source default/source; fi; \
    fi && \
    chown -R ghost:ghost /home/ghost

USER ghost

EXPOSE 2368

CMD ["node", "index.js"]
