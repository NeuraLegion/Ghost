# syntax=docker/dockerfile:1-labs@sha256:7eca9451d94f9b8ad22e44988b92d595d3e4d65163794237949a8c3413fbed5d

# Production Dockerfile for Ghost
# Two targets:
#   core — server + production deps, no admin (Ghost-Pro base)
#   full — core + built admin (self-hosting)
#
# Build context: extracted `npm pack` output from ghost/core

ARG NODE_VERSION=22.18.0

# ---- Core: server + production deps ----
FROM node:$NODE_VERSION-bookworm-slim AS core

ARG GHOST_BUILD_VERSION=""
ENV NODE_ENV=production
ENV CI=true
ENV GHOST_BUILD_VERSION=${GHOST_BUILD_VERSION}

RUN apt-get update && \
    apt-get install -y --no-install-recommends libjemalloc2 fontconfig && \
    rm -rf /var/lib/apt/lists/* && \
    groupmod -g 1001 node && \
    usermod -u 1001 node && \
    adduser --disabled-password --gecos "" -u 1000 ghost

WORKDIR /home/ghost

COPY --exclude=core/built/admin . .

RUN corepack enable && pnpm config set store-dir /root/.local/share/pnpm/store

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=pnpm-store \
    apt-get update && \
    apt-get install -y --no-install-recommends build-essential python3 git && \
    export MAKEFLAGS="-j$(nproc)" && \
    pnpm install --ignore-scripts --prefer-offline && \
    pnpm --dir ghost/parse-email-address run build:tsc && \
    pnpm --dir ghost/core run build:tsc && \
    pnpm --dir ghost/core run build:assets && \
    mkdir -p /home/ghost/ghost/core/node_modules && \
    cp -R node_modules/. /home/ghost/ghost/core/node_modules/ && \
    ([ -d /home/ghost/ghost/core/node_modules/sqlite3 ] && cd /home/ghost/ghost/core/node_modules/sqlite3 && npm run install || true) && \
    apt-get purge -y build-essential python3 git && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/* /tmp/ghost-runtime && \
    mkdir -p /home/ghost/ghost/core/content/logs /home/ghost/ghost/core/content/public /home/ghost/ghost/core/content/settings /home/ghost/ghost/core/content/images /home/ghost/ghost/core/content/data /home/ghost/ghost/core/content/adapters /home/ghost/ghost/core/content/themes && \
    mkdir -p /home/ghost/ghost/core/default && \
    cp -R /home/ghost/ghost/core/content /home/ghost/ghost/core/base_content && \
    if [ -d /home/ghost/ghost/core/content/themes/casper ]; then cp -R /home/ghost/ghost/core/content/themes/casper /home/ghost/ghost/core/default/casper; fi && \
    if [ -d /home/ghost/ghost/core/content/themes/source ]; then cp -R /home/ghost/ghost/core/content/themes/source /home/ghost/ghost/core/default/source; fi && \
    chown ghost:ghost /home/ghost && \
    chown -R nobody:nogroup /home/ghost/* && \
    chown -R ghost:ghost /home/ghost/ghost/core/content /home/ghost/ghost/core/content/logs

USER ghost
ENV LD_PRELOAD=libjemalloc.so.2

EXPOSE 2368

WORKDIR /home/ghost/ghost/core
CMD ["node", "index.js"]

# ---- Full: core + admin ----
FROM core AS full

USER root
COPY ghost/core/core/built/admin core/built/admin
RUN chown -R nobody:nogroup core/built/admin
USER ghost
