# syntax=docker/dockerfile:1-labs@sha256:7eca9451d94f9b8ad22e44988b92d595d3e4d65163794237949a8c3413fbed5d

ARG NODE_VERSION=22.18.0
FROM node:${NODE_VERSION}-bookworm-slim

ARG GHOST_BUILD_VERSION=""

ENV NODE_ENV=production \
    GHOST_BUILD_VERSION=${GHOST_BUILD_VERSION} \
    LD_PRELOAD=libjemalloc.so.2 \
    MAKEFLAGS=-j4

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        python3 \
        python3-setuptools \
        git \
        libjemalloc2 \
        fontconfig && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    groupmod -g 1001 node && \
    usermod -u 1001 node && \
    adduser --disabled-password --gecos "" -u 1000 ghost

WORKDIR /workspace

COPY . .

RUN corepack enable && \
    pnpm config set store-dir /root/.local/share/pnpm/store && \
    pnpm config set package-import-method copy && \
    pnpm config set force-legacy-deploy true

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=pnpm-store \
    bash -lc 'set -eux; \
    export MAKEFLAGS="-j$(nproc)"; \
    pnpm install --frozen-lockfile --prefer-offline; \
    pnpm run build:production'

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=pnpm-store \
    bash -lc 'set -eux; \
    rm -rf /tmp/ghost-prod; \
    pnpm --filter ghost deploy --prod /tmp/ghost-prod --legacy'

RUN bash -lc 'set -eux; \
    rm -rf /home/ghost/ghost; \
    install -d -o ghost -g ghost /home/ghost/ghost/core; \
    cp -a /tmp/ghost-prod/. /home/ghost/ghost/core/; \
    if [ -d /home/ghost/ghost/core/node_modules/sqlite3 ]; then \
        cd /home/ghost/ghost/core/node_modules/sqlite3 && npm run install; \
    fi; \
    install -d -o ghost -g ghost \
        /home/ghost/ghost/core/content \
        /home/ghost/ghost/core/content/public \
        /home/ghost/ghost/core/content/logs \
        /home/ghost/ghost/core/content/images \
        /home/ghost/ghost/core/content/adapters \
        /home/ghost/ghost/core/content/data \
        /home/ghost/ghost/core/content/settings; \
    chown -R ghost:ghost /home/ghost/ghost'

WORKDIR /home/ghost/ghost/core

USER ghost

EXPOSE 2368

CMD ["node", "index.js"]
