# syntax=docker/dockerfile:1-labs@sha256:7eca9451d94f9b8ad22e44988b92d595d3e4d65163794237949a8c3413fbed5d

ARG NODE_VERSION=22.18.0
FROM node:${NODE_VERSION}-bookworm-slim

ARG GHOST_BUILD_VERSION=""

ENV NODE_ENV=production \
    CI=true \
    GHOST_BUILD_VERSION=${GHOST_BUILD_VERSION} \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    LD_PRELOAD=libjemalloc.so.2

WORKDIR /home/ghost

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        python3 \
        git \
        libjemalloc2 \
        fontconfig; \
    rm -rf /var/lib/apt/lists/*; \
    usermod -l ghost node; \
    groupmod -n ghost node; \
    usermod -d /home/ghost ghost; \
    mkdir -p /home/ghost /pnpm; \
    chown -R ghost:ghost /home/ghost /pnpm

COPY . .

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

RUN --mount=type=cache,target=/pnpm/store,id=pnpm-store \
    set -eux; \
    export npm_config_jobs="$(nproc)"; \
    export MAKEFLAGS="-j$(nproc)"; \
    pnpm config set store-dir /pnpm/store; \
    pnpm add -Dw esbuild@0.27.4 --ignore-workspace-root-check; \
    pnpm install --no-frozen-lockfile --prefer-offline; \
    pnpm --dir ghost/parse-email-address build; \
    pnpm --dir ghost/core build:tsc; \
    pnpm --dir ghost/core build:assets; \
    pnpm --dir apps/admin build

RUN set -eux; \
    mkdir -p base_content default log ghost/core/content/themes; \
    cp -a ghost/core/content/. base_content/; \
    rm -rf ghost/core/content/themes/casper ghost/core/content/themes/source; \
    cp -a ghost/core/test/utils/fixtures/themes/casper ghost/core/content/themes/; \
    cp -a ghost/core/test/utils/fixtures/themes/source ghost/core/content/themes/; \
    chown -R ghost:ghost /home/ghost /pnpm

USER ghost

EXPOSE 2368

CMD ["node", "ghost/core/index.js"]
