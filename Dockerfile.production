# syntax=docker/dockerfile:1-labs@sha256:7eca9451d94f9b8ad22e44988b92d595d3e4d65163794237949a8c3413fbed5d

ARG NODE_VERSION=22.18.0

FROM node:${NODE_VERSION}-bookworm-slim

ARG GHOST_BUILD_VERSION=""

ENV NODE_ENV=production \
    GHOST_BUILD_VERSION=${GHOST_BUILD_VERSION} \
    PNPM_HOME=/usr/local/share/pnpm \
    PATH=/usr/local/share/pnpm:${PATH} \
    npm_config_build_from_source=true \
    npm_config_loglevel=warn \
    CI=true \
    NX_DAEMON=false \
    LD_PRELOAD=libjemalloc.so.2

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        python3 \
        git \
        curl \
        ca-certificates \
        fontconfig \
        libjemalloc2 \
        procps && \
    rm -rf /var/lib/apt/lists/* && \
    groupmod -g 1001 node && \
    usermod -u 1001 node && \
    adduser --disabled-password --gecos "" -u 1000 ghost

WORKDIR /home/ghost

COPY . /home/ghost

RUN corepack enable && \
    corepack prepare pnpm@10.33.0 --activate

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=pnpm-store \
    sh -eux -c '\
      export MAKEFLAGS="-j$(nproc)"; \
      cd /home/ghost; \
      pnpm config set store-dir /root/.local/share/pnpm/store; \
      pnpm install --frozen-lockfile --prefer-offline; \
      pnpm nx run ghost:build:tsc; \
      pnpm nx run ghost:build:assets; \
      pnpm nx run ghost-admin:build; \
      pnpm nx run @tryghost/admin:build; \
      cd /home/ghost/ghost/core; \
      if [ -d node_modules/sqlite3 ]; then \
        cd node_modules/sqlite3 && npm run install && cd /home/ghost/ghost/core; \
      fi; \
      mkdir -p base_content default log; \
      cp -a content/. base_content/; \
      mkdir -p content/settings; \
      printf "routes:\n\ncollections:\n  /:\n    permalink: /{slug}/\n\ntaxonomies:\n  tag: /tag/{slug}/\n  author: /author/{slug}/\n" > content/settings/routes.yaml; \
      chown -R ghost:ghost /home/ghost \
    '

RUN apt-get update && \
    apt-get purge -y --auto-remove build-essential python3 git curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /home/ghost/ghost/core

USER ghost

EXPOSE 2368

CMD ["node", "index.js"]
